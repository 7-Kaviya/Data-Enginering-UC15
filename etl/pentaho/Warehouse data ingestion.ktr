    <connection>ERP Staging Input</connection>
    <sql>SELECT
  item_id
, category
, stock_level
, reorder_point
, reorder_frequency_days
, lead_time_days
, daily_demand
, demand_std_dev
, item_popularity_score
, storage_location_id
, "zone"
, picking_time_seconds
, handling_cost_per_unit
, unit_price
, holding_cost_per_unit_day
, stockout_count_last_month
, order_fulfillment_rate
, total_orders_last_month
, turnover_ratio
, layout_efficiency_score
, last_restock_date
, forecasted_demand_next_7d
, kpi_score
FROM "public".warehouse_data
</sql>
